---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSitemapLinks, getAllBlogPosts } from '../lib/queries';

const sanityLinks = await getSitemapLinks();
const blogPosts = await getAllBlogPosts();

const defaultLinks = [
    {
        category: "Pages Principales",
        items: [
            { name: "Accueil", href: "/" },
            { name: "Le cabinet (Qui sommes-nous)", href: "/qui-sommes-nous" },
            { name: "Nos soins (Services)", href: "/services" },
            { name: "Articles & Actualités", href: "/blog" },
            { name: "Contact & Rendez-vous", href: "/contact" }
        ]
    },
    {
        category: "Nos soins",
        items: [
            { name: "Dentisterie Pédiatrique", href: "/services#pediatrics" },
            { name: "Dentisterie Esthétique", href: "/services#cosmetic" },
            { name: "Implantologie", href: "/services#implants" },
            { name: "Orthodontie", href: "/services#ortho" }
        ]
    },
    {
        category: "Légal",
        items: [
            { name: "Politique de Confidentialité", href: "/politique-de-confidentialite" },
            { name: "Plan du Site", href: "/plan-du-site" }
        ]
    }
];

const hasArticleLinks = (sanityLinks ?? []).some((g: any) => g.items?.some((i: any) => i.href?.startsWith('/blog/')));
const blogGroup = blogPosts?.length && !hasArticleLinks ? [{
    category: "Articles",
    items: blogPosts.map((p: any) => ({ name: p.title, href: `/blog/${p.slug}` }))
}] : [];

const links = [...(sanityLinks?.length ? sanityLinks : defaultLinks), ...blogGroup];
---

<Layout
    title="Plan du Site | Cabinet Dentaire Chorfi"
    description="Plan du site du Cabinet Dentaire Chorfi. Retrouvez toutes les pages de notre site."
    breadcrumbs={[{ name: "Plan du site", href: "/plan-du-site" }]}
>
    <Navbar />
    
    <main>
        <PageHeader 
            title="Explorez Notre Site" 
            subtitle="Plan du Site" 
        />

        <section class="py-24 bg-white text-oralix-dark">
            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
                    {links.map(group => (
                        <div class="sitemap-group">
                            <h2 class="text-3xl font-bold mb-8 font-bricolage border-b border-black/5 pb-4">{group.category}</h2>
                            <ul class="space-y-4">
                                {group.items.map(item => (
                                    <li>
                                        <a href={item.href} class="flex items-center gap-3 text-lg text-gray-500 hover:text-oralix-brand hover:translate-x-2 transition-all duration-300 group">
                                            <div class="w-1.5 h-1.5 rounded-full bg-black/10 group-hover:bg-oralix-brand"></div>
                                            {item.name}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<script>
    import { gsap } from 'gsap';
    
    gsap.from('.sitemap-group', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: 'power3.out'
    });
</script>
