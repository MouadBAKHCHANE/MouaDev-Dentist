---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import GallerieSection from '../components/GallerieSection.astro';
import Testimonials from '../components/Testimonials.astro';
import Blog from '../components/Blog.astro';
import ContactSection from '../components/ContactSection.astro';
import AppointmentCTA from '../components/AppointmentCTA.astro';
import Footer from '../components/Footer.astro';
import { urlFor } from '../lib/sanity';
import { getHomePage } from '../lib/queries';

const homePage = await getHomePage();
const seo = homePage?.seo;
---

<Layout
	title={seo?.metaTitle ?? "Cabinet Dentaire Chorfi | Dentiste à Salé"}
	description={seo?.metaDescription}
	ogImage={seo?.ogImage ? urlFor(seo.ogImage).width(1200).height(630).format('webp').url() : undefined}
	noIndex={seo?.noIndex}
>
	<Navbar />
	<main>
		<Hero />
		<AboutSection />
		<Services />
		<Process />
		<BeforeAfter />
		<Testimonials />
		<GallerieSection />
		<Blog />
		<ContactSection />
		<AppointmentCTA />
	</main>
	<Footer />
</Layout>
