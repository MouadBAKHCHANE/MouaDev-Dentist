---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { urlFor } from '../lib/sanity';
import { getTeamMembers, getClinicFeatures, getAboutPage, getSiteSettings } from '../lib/queries';
import { DOCTOR_ID, DENTIST_ID } from '../lib/schema';

const aboutPage = await getAboutPage();
const settings = await getSiteSettings();
const sanityTeam = await getTeamMembers();
const sanityClinic = await getClinicFeatures();

const doctor = sanityTeam?.[0];
const trainings = doctor?.trainings ?? [
    "Lauréate de la faculté de médecine dentaire de Rabat",
    "Certifiée en Parodontie par le centre de formation français 'LearnyLib'",
    "Certifiée en Endodontie par le centre de formation français 'LearnyLib'",
    "Certifiée en Stratification directe anterieures par le centre de formation français 'LearnyLib'",
    "Formation en facettes composites stratifiées",
    "Formation en chirurgie buccale",
    "Certificat post-universitaire en orthopédie",
    "Certificat en imagerie dento-maxillaire et radioprotection"
];

const personJsonLd = {
    "@context": "https://schema.org",
    "@type": ["Person", "Dentist"],
    "@id": DOCTOR_ID,
    "name": aboutPage?.doctorName ?? doctor?.name ?? "Dr Zainab Chorfi",
    "jobTitle": aboutPage?.doctorTitle ?? doctor?.title ?? "Chirurgien-dentiste",
    "url": "https://www.cabinetdentairechorfi.com/qui-sommes-nous",
    "telephone": ["+212644801152", "+212538716787"],
    "worksFor": { "@id": DENTIST_ID },
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Avenue Moulay Youssef n 19, 1er étage",
        "addressLocality": "Tabriquet, Salé",
        "postalCode": "11000",
        "addressCountry": "MA"
    },
    "sameAs": [
        "https://www.instagram.com/cabinet.dentaire.chorfi/",
        "https://www.facebook.com/61576404963248/about/"
    ]
};

const clinics = sanityClinic?.length ? sanityClinic.map((c: any) => ({
    image: c.image ? urlFor(c.image).width(800).format('webp').url() : '/images/le cabinet/clinic-1.jpg.webp',
    title: c.title,
    desc: c.description
})) : [
    { image: "/images/le cabinet/clinic-1.jpg.webp", title: "Scan 3D et empreintes numériques", desc: "Technologies de pointe pour une précision chirurgicale et esthétique." },
    { image: "/images/le cabinet/clinic-2.jpg.webp", title: "Imagerie avancée", desc: "Diagnostics d'une extrême précision avec nos équipements d'imagerie." },
    { image: "/images/le cabinet/clinic-6.jpg.jpeg.webp", title: "Soins personnalisés", desc: "Une approche humaine et technologique pour chaque patient." },
    { image: "/images/le cabinet/clinic-3.jpg.webp", title: "Espace d'attente", desc: "Un cadre apaisant et élégant pour votre confort avant le traitement." },
    { image: "/images/le cabinet/clinic-4.jpg.webp", title: "Accueil et Conseil", desc: "Un accueil personnalisé pour vous accompagner dans votre parcours de soins." },
    { image: "/images/le cabinet/clinic-5.jpg.webp", title: "Radiographie panoramique", desc: "Équipement Myray pour une vision globale et précise de votre santé dentaire." }
];
---

<Layout
    title="Dr Chorfi Zainab | Qui Sommes Nous"
    description="Découvrez Dr Zainab Chorfi et son cabinet dentaire à Salé. Équipements modernes, approche humaine et soins personnalisés."
    breadcrumbs={[{ name: "Qui Sommes-Nous", href: "/qui-sommes-nous" }]}
    jsonLd={personJsonLd}
>
    <link slot="head" rel="preload" as="image" href="/images/le cabinet/dr-chorfi-sitting.webp" type="image/webp" />
    <Navbar />
    
    <main class="bg-[#141C18]">
        {/* Hero Section - Dr Profile - Dark Header */}
        <div class="bg-[#141C18] relative">
            <section class="pt-32 pb-16 lg:pb-12 px-6 lg:px-8 max-w-7xl mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
                    {/* Left Side: Info */}
                    <div class="order-2 lg:order-1 flex flex-col gap-5 items-center lg:items-start text-center lg:text-left">
                        <div class="space-y-2">
                            <h1 class="text-4xl lg:text-5xl font-bold font-bricolage text-white">
                                {aboutPage?.doctorName ?? doctor?.name ?? "Dr Zainab Chorfi"}
