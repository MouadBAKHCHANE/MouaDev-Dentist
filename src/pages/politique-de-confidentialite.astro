---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLegalPage } from '../lib/queries';

const page = await getLegalPage('politique-de-confidentialite');

const contentBlocks = (page?.content ?? []).filter((block: any) =>
    !page?.lastUpdated || !block.text?.trim().toLowerCase().startsWith('dernière mise à jour')
);
---

<Layout
    title="Politique de Confidentialité | Cabinet Dentaire Chorfi"
    description="Politique de confidentialité du Cabinet Dentaire Chorfi. Protection de vos données personnelles."
>
    <Navbar />
    
    <main>
        <PageHeader 
            title="Votre Vie Privée est Notre Priorité" 
            subtitle="Confidentialité" 
        />

        <section class="py-24 bg-white">
            <div class="max-w-4xl mx-auto px-6 lg:px-8">
                <div class="prose prose-lg prose-headings:font-bricolage prose-headings:text-oralix-dark prose-p:text-gray-500 prose-li:text-gray-500">
                    {page?.lastUpdated && <p class="mb-8">Dernière mise à jour : {page.lastUpdated}</p>}
                    {contentBlocks.length ? (
                        contentBlocks.map((block: any) => {
                            if (block.type === 'h2') return <h2 class="text-3xl font-bold mt-12 mb-6">{block.text}</h2>;
                            if (block.type === 'ul') return <ul class="list-disc pl-6 mb-8"><li>{block.text}</li></ul>;
                            return <p>{block.text}</p>;
                        })
                    ) : (
                        <>
                            <p class="mb-8">Dernière mise à jour : 28 Février 2026</p>
                            <h2 class="text-3xl font-bold mb-6">1. Collecte des informations</h2>
                            <p>Nous collectons des informations lorsque vous remplissez notre formulaire de contact ou de prise de rendez-vous sur le site.</p>
                            <h2 class="text-3xl font-bold mt-12 mb-6">2. Utilisation des informations</h2>
                            <p>Toutes les informations que nous recueillons auprès de vous peuvent être utilisées pour vous contacter et répondre à vos demandes.</p>
                            <h2 class="text-3xl font-bold mt-12 mb-6">3. Confidentialité des données</h2>
                            <p>Vos informations personnelles ne seront pas vendues, échangées ou transférées sans votre consentement.</p>
                            <h2 class="text-3xl font-bold mt-12 mb-6">4. Protection des informations</h2>
                            <p>Nous utilisons un cryptage SSL pour protéger les informations sensibles transmises en ligne.</p>
                            <h2 class="text-3xl font-bold mt-12 mb-6">5. Consentement</h2>
                            <p>En utilisant notre site, vous consentez à notre politique de confidentialité.</p>
                        </>
                    )}
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
