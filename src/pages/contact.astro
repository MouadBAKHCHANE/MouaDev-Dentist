---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { urlFor } from '../lib/sanity';
import { getContactPage, getSiteSettings, getFaqs } from '../lib/queries';

const contactPage = await getContactPage();
const settings = await getSiteSettings();
const sanityFaqs = await getFaqs();

const phones = settings?.phones ?? ["06 44 80 11 52", "05 38 71 67 87"];
const address = settings?.address ?? { street: "Avenue Moulay Youssef n° 19", floor: "1er étage, Tabriquet, Salé", mapUrl: "https://www.google.com/maps/place/CABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab/@34.0377681,-6.8033237,17z/data=!4m16!1m9!3m8!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!2sCABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab!8m2!3d34.0378219!4d-6.803389!9m1!1b1!16s%2Fg%2F11x8_5f85j!3m5!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!8m2!3d34.0378219!4d-6.803389!16s%2Fg%2F11x8_5f85j?entry=ttu&g_ep=EgoyMDI2MDIyNS4wIKXMDSoASAFQAw%3D%3D" };
const whatsappNumber = settings?.whatsappNumber ?? "212644801152";
const serviceOptions = contactPage?.serviceOptions ?? ["Dentisterie Esthétique", "Implants", "Orthodontie", "Consultation générale"];
const mapEmbedUrl = contactPage?.mapEmbedUrl ?? "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3306.772592534885!2d-6.803389!3d34.0378219!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda741f8f835d4d3%3A0x52d01fb697aaeaf4!2sCABINET%20DENTAIRE%20CHORFI%20Dr%20CHORFI%20Zainab!5e0!3m2!1sfr!2sma!4v1711234567890!5m2!1sfr!2sma";
const headerImage = contactPage?.headerImage ? urlFor(contactPage.headerImage).width(800).format('webp').url() : "/images/process/step1.webp";
const pageTitle = contactPage?.pageTitle ?? "Prêt pour un nouveau sourire ?";
const pageSubtitle = contactPage?.pageSubtitle ?? "Contact";
const formBadge = contactPage?.formBadge ?? "Contactez-nous";
const formTitle = contactPage?.formTitle ?? "Prenez rendez-vous";
const helpTitle = contactPage?.helpTitle ?? "Besoin d'aide immédiate?";
const helpText = contactPage?.helpText ?? "Notre équipe est disponible pour répondre à toutes vos questions par WhatsApp ou téléphone. Nous vous accompagnons à chaque étape.";

const faqs = sanityFaqs?.length ? sanityFaqs.map((f: any) => ({ q: f.question, a: f.answer })) : [
    { q: "Quelles sont les méthodes de paiement ?", a: "Nous acceptons les espèces, les chèques, les virements bancaires." },
    { q: "Acceptez-vous les urgences ?", a: "Oui, nous réservons des créneaux quotidiens pour recevoir les patients en cas de douleur aiguë ou d'imprévu." },
    { q: "Comment se déroule la première visite ?", a: "La première consultation comprend un examen complet, des radiographies si nécessaire et l'établissement d'un plan de traitement personnalisé." },
    { q: "Le cabinet est-il accessible ?", a: "Oui, notre équipe est là pour vous accueillir confortablement au 1er étage de l'immeuble." }
];

const contactInfo = [
    {
        title: contactPage?.contactInfoPhoneTitle ?? "Téléphone",
        details: phones,
        icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
        link: `tel:${phones[0]?.replace(/\s/g, '')}`,
        isPhone: true
    },
    {
        title: contactPage?.contactInfoAddressTitle ?? "Notre adresse",
        details: [address.street, `${address.floor ?? ''}, ${address.city ?? ''}`].filter(Boolean),
        icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
        link: address.mapUrl ?? "#"
    },
    {
        title: contactPage?.contactInfoHoursTitle ?? "Horaires d'ouverture",
        details: contactPage?.contactInfoHoursDetails ?? ["Lundi-Vendredi : 09h - 13h | 15h - 19h", "Samedi : 09h - 13h"],
        icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
        link: "#"
    }
];

const seo = contactPage?.seo;

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": f.a
        }
    }))
};
---

<Layout
    title={seo?.metaTitle ?? "Contactez-nous | Cabinet Dentaire Chorfi"}
    description={seo?.metaDescription ?? "Prenez rendez-vous au Cabinet Dentaire Chorfi à Salé. Appelez-nous ou remplissez le formulaire en ligne."}
    ogImage={seo?.ogImage ? urlFor(seo.ogImage).width(1200).height(630).format('webp').url() : undefined}
    noIndex={seo?.noIndex}
    jsonLd={faqJsonLd}
    breadcrumbs={[{ name: "Contact", href: "/contact" }]}
>
    <Navbar />
    
    <main>
        <PageHeader
            title={pageTitle}
            subtitle={pageSubtitle}
            image={headerImage}
        />

        <section class="py-24 bg-white">
            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-24 contact-cards-grid">
                    {contactInfo.map(info => (
                        info.isPhone ? (
                            <div class="group bg-[#F6F7F9] p-6 rounded-2xl border border-black/5 hover:border-oralix-brand/30 transition-all duration-500 hover:shadow-xl hover:shadow-black/5 contact-card">
                                <div class="flex items-center gap-3 mb-3">
                                    <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-oralix-dark shadow-sm group-hover:bg-oralix-brand group-hover:scale-110 transition-all duration-500" set:html={info.icon}></div>
                                    <h3 class="text-lg font-bold text-oralix-dark font-bricolage">{info.title}</h3>
                                </div>
                                <div class="space-y-1 pl-[52px]">
                                    {info.details.map(detail => (
                                        <a href={`tel:${detail.replace(/\s/g, '')}`} class="block w-fit text-gray-600 font-semibold font-inter text-sm hover:text-oralix-dark hover:underline decoration-oralix-brand decoration-2 underline-offset-4 transition-colors">{detail}</a>
                                    ))}
                                </div>
                            </div>
                        ) : (
                        <a href={info.link} target={info.link.startsWith('http') ? '_blank' : '_self'} class="group bg-[#F6F7F9] p-6 rounded-2xl border border-black/5 hover:border-oralix-brand/30 transition-all duration-500 hover:shadow-xl hover:shadow-black/5 contact-card">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-oralix-dark shadow-sm group-hover:bg-oralix-brand group-hover:scale-110 transition-all duration-500" set:html={info.icon}></div>
                                <h3 class="text-lg font-bold text-oralix-dark font-bricolage">{info.title}</h3>
                            </div>
                            <div class="space-y-1 pl-[52px]">
                                {info.details.map(detail => (
                                    <p class="text-gray-600 font-semibold font-inter text-sm">{detail}</p>
                                ))}
                            </div>
                        </a>
                        )
                    ))}
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
                    {/* Left Column: Form */}
                    <div class="lg:col-span-7">
                        <div class="bg-white rounded-[2rem] p-8 lg:p-10 shadow-xl border border-black/5 relative overflow-hidden contact-form-wrapper">
                            <div class="mb-6 text-left">
                                <div class="flex items-center gap-2 text-gray-500 text-xs font-bold uppercase tracking-wider mb-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-[#D1F26E]"></span>
                                    {formBadge}
                                </div>
                                <h2 class="text-3xl lg:text-4xl font-bold font-bricolage text-[#141C18] leading-tight">
                                    {formTitle}
                                </h2>
                            </div>
                            
                            <form class="space-y-4" id="contact-form">
                                <div id="form-success" class="hidden bg-green-50 border border-green-200 text-green-800 rounded-2xl p-4 text-sm font-medium">
                                    {settings?.formSuccessMessage ?? "Votre demande a été envoyée avec succès ! Nous vous recontacterons rapidement."}
                                </div>
                                <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-800 rounded-2xl p-4 text-sm font-medium">
                                    {settings?.formErrorMessage ?? "Une erreur est survenue. Veuillez réessayer ou nous contacter par téléphone."}
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-tight mb-1 content-px">{settings?.formLabelName ?? "Nom Complet"}*</label>
                                    <input
                                        type="text"
                                        name="name"
                                        required
                                        placeholder="Votre nom"
                                        class="w-full px-5 py-3 bg-[#F6F7F9] border-none rounded-full focus:ring-2 focus:ring-[#D1F26E] outline-none transition-all text-sm"
                                    />
                                </div>

                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-tight mb-1 content-px">{settings?.formLabelPhone ?? "Téléphone"}*</label>
                                        <input
                                            type="tel"
                                            name="phone"
                                            required
                                            placeholder="06 12 34 56 78"
                                            class="w-full px-5 py-3 bg-[#F6F7F9] border-none rounded-full focus:ring-2 focus:ring-[#D1F26E] outline-none transition-all text-sm"
                                        />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-tight mb-1 content-px">{settings?.formLabelEmail ?? "E-mail"}</label>
                                        <input
                                            type="email"
                                            name="email"
                                            placeholder="votre@email.com"
                                            class="w-full px-5 py-3 bg-[#F6F7F9] border-none rounded-full focus:ring-2 focus:ring-[#D1F26E] outline-none transition-all text-sm"
                                        />
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-tight mb-1 content-px">{settings?.formLabelService ?? "Type de soin"}</label>
                                        <select name="service" class="w-full px-5 py-3 bg-[#F6F7F9] border-none rounded-full focus:ring-2 focus:ring-[#D1F26E] outline-none transition-all appearance-none cursor-pointer text-sm">
                                            <option value="">{settings?.formServicePlaceholder ?? "Choisir un soin"}</option>
                                            {serviceOptions.map((opt: string) => <option>{opt}</option>)}
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-tight mb-1 content-px">{settings?.formLabelDate ?? "Date souhaitée"}</label>
                                        <input
                                            type="text"
                                            name="date"
                                            id="datepicker"
                                            placeholder="Sélectionner une date"
                                            class="w-full px-5 py-3 bg-[#F6F7F9] border-none rounded-full focus:ring-2 focus:ring-[#D1F26E] outline-none transition-all cursor-pointer text-sm"
                                        />
                                    </div>
                                </div>

                                <div class="flex items-start gap-3 px-1 mt-2">
                                    <input type="checkbox" id="disclaimer" class="mt-1 w-4 h-4 rounded border-gray-300 text-[#D1F26E] focus:ring-[#D1F26E] cursor-pointer shrink-0" />
                                    <label for="disclaimer" class="text-[13px] text-gray-500 leading-tight cursor-pointer select-none">
                                        {settings?.formDisclaimerText ?? "J'autorise le cabinet à me recontacter pour confirmer mon rendez-vous*"}
                                    </label>
                                </div>

                                <button
                                    id="submit-btn"
                                    disabled
                                    data-submit-text={settings?.formSubmitText ?? "Confirmer ma demande de rendez-vous"}
                                    class="w-full bg-[#D1F26E] disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed text-[#141C18] font-bold py-3 sm:py-4 px-4 rounded-full hover:bg-[#c4e661] transition-all flex items-center justify-center gap-2 group mt-2 font-bricolage text-xs sm:text-sm md:text-base shadow-lg shadow-black/5"
                                >
                                    {settings?.formSubmitText ?? "Confirmer ma demande de rendez-vous"}
                                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>

                    {/* Right Column: FAQ & Extra Info */}
                    <div class="lg:col-span-5 flex flex-col gap-12">
                        {faqs?.length > 0 && (
                        <div>
                            <div class="flex items-center gap-2 text-gray-500 text-sm font-medium mb-4">
                                <span class="w-1.5 h-1.5 rounded-full bg-oralix-brand"></span>
                                {contactPage?.faqBadge ?? "Questions fréquentes"}
                            </div>
                            <h2 class="text-3xl lg:text-4xl font-bricolage text-oralix-dark mb-8 leading-tight">{contactPage?.faqTitle ?? "Aide et informations"}</h2>

                            <div class="space-y-4">
                                {faqs.map((faq, index) => (
                                    <details class="group bg-[#F6F7F9] rounded-3xl overflow-hidden border border-transparent transition-all hover:border-black/5">
                                        <summary class="flex items-center justify-between p-6 cursor-pointer list-none list-inside">
                                            <span class="font-bold text-oralix-dark font-bricolage text-lg">{faq.q}</span>
                                            <span class="w-8 h-8 rounded-full bg-white flex items-center justify-center transition-transform group-open:rotate-180">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                                            </span>
                                        </summary>
                                        <div class="px-6 pb-6 text-gray-500 leading-relaxed font-inter">
                                            {faq.a}
                                        </div>
                                    </details>
                                ))}
                            </div>
                        </div>
                        )}
                    </div>
                </div>

                {/* Expanded Help Card */}
                {(contactPage?.helpTitle || contactPage?.helpText) && (
                <div class="mt-16 bg-[#F6F7F9] p-10 lg:p-12 rounded-[3rem] border border-black/5 flex flex-col lg:flex-row items-center justify-between gap-8 relative overflow-hidden group">
                    <div class="absolute right-0 top-0 w-64 h-64 bg-oralix-brand/10 rounded-full blur-3xl -mr-32 -mt-32 transition-colors group-hover:bg-oralix-brand/20"></div>
                    <div class="relative z-10 max-w-2xl text-center lg:text-left">
                        <h3 class="text-3xl lg:text-4xl font-bold text-oralix-dark mb-4 font-bricolage">{helpTitle}</h3>
                        <p class="text-gray-600 text-lg font-medium leading-relaxed">{helpText}</p>
                    </div>
                    <div class="relative z-10 shrink-0">
                        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" class="flex items-center gap-4 bg-oralix-brand text-oralix-dark px-10 py-5 rounded-full font-bold hover:scale-105 transition-all shadow-lg shadow-oralix-brand/20 text-sm lg:text-lg">
                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.431 5.63 1.432h.006c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                            {contactPage?.helpCtaText ?? "Contactez-nous"}
                        </a>
                    </div>
                </div>
                )}

                {/* Full Width Map Section */}
                {(contactPage?.mapTitle || mapEmbedUrl) && (
                <div class="mt-24">
                    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between mb-8 gap-4">
                        <div>
                            <div class="flex items-center gap-2 text-gray-500 text-sm font-medium mb-4">
                                <span class="w-1.5 h-1.5 rounded-full bg-oralix-brand"></span>
                                {contactPage?.mapBadge ?? "Localisation"}
                            </div>
                            <h2 class="text-3xl lg:text-5xl font-bricolage text-oralix-dark leading-tight">{contactPage?.mapTitle ?? "Nous trouver au cabinet"}</h2>
                        </div>
                        <a href={address.mapUrl ?? '#'} target="_blank" class="hidden lg:flex items-center gap-2 bg-oralix-dark text-white px-8 py-4 rounded-full font-bold hover:scale-105 transition-all text-sm">
                            {contactPage?.mapButtonText ?? "Ouvrir dans Google Maps"}
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                        </a>
                    </div>

                    <div class="rounded-[2rem] lg:rounded-[4rem] overflow-hidden aspect-square lg:aspect-[21/9] min-h-[250px] lg:min-h-[400px] shadow-2xl border-4 border-white">
                        <iframe
                            src={mapEmbedUrl}
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </div>
                </div>
                )}
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import flatpickr from "flatpickr";
    import { French } from "flatpickr/dist/l10n/fr.js";
    import "flatpickr/dist/flatpickr.css";
    
    gsap.registerPlugin(ScrollTrigger);

    gsap.from('.contact-card', {
        scrollTrigger: {
            trigger: '.contact-cards-grid',
            start: 'top 90%',
        },
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power2.out',
        clearProps: 'all'
    });

    gsap.from('.contact-form-wrapper', {
        scrollTrigger: {
            trigger: '.contact-form-wrapper',
            start: 'top 80%',
        },
        y: 40,
        opacity: 0,
        duration: 1.2,
        ease: 'power3.out'
    });

    // Initialize flatpickr
    flatpickr("#datepicker", {
        locale: French,
        dateFormat: "d/m/Y",
        minDate: "today",
        disableMobile: "true"
    });

    // Toggle submit button based on disclaimer
    const disclaimer = document.getElementById('disclaimer') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (disclaimer && submitBtn) {
        disclaimer.addEventListener('change', (e) => {
            const isChecked = (e.target as HTMLInputElement).checked;
            submitBtn.disabled = !isChecked;
        });
    }

    // Form submission
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);
        const data = {
            name: formData.get('name'),
            phone: formData.get('phone'),
            email: formData.get('email'),
            service: formData.get('service'),
            date: formData.get('date'),
        };

        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Envoi en cours...';
        }

        try {
            const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            if (res.ok) {
                successMsg?.classList.remove('hidden');
                form.reset();
                if (submitBtn) submitBtn.disabled = true;
            } else {
                errorMsg?.classList.remove('hidden');
            }
        } catch {
            errorMsg?.classList.remove('hidden');
        } finally {
            if (submitBtn) {
                const btnText = submitBtn.getAttribute('data-submit-text') || 'Confirmer ma demande de rendez-vous';
                submitBtn.innerHTML = `${btnText} <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>`;
                const cb = document.getElementById('disclaimer') as HTMLInputElement;
                submitBtn.disabled = !cb?.checked;
            }
        }
    });
</script>
