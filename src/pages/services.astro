---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Process from '../components/Process.astro';
import AppointmentCTA from '../components/AppointmentCTA.astro';
import ContactSection from '../components/ContactSection.astro';
import { urlFor } from '../lib/sanity';
import { getServicesPage, getServices } from '../lib/queries';

const servicesPage = await getServicesPage();
const sanityServices = await getServices();

const serviceHero = {
    badge: (servicesPage?.badge ?? "Services").replace(/^[•\s]+/, ""),
    title: servicesPage?.title ?? "Nos soins",
    desc: servicesPage?.description ?? "",
    video: servicesPage?.videoUrl ?? "https://videos.pexels.com/video-files/6630295/6630295-hd_1366_720_25fps.mp4",
    poster: servicesPage?.posterImage ? urlFor(servicesPage.posterImage).width(1200).format('webp').url() : "/original_hero_service_1772228247469.webp"
};

const stats = servicesPage?.stats?.length ? servicesPage.stats : [
    { label: "années d'expérience", value: "Plusieurs" },
    { label: "sourires transformés", value: "De nombreux" }
];

const mainServices = sanityServices?.length ? sanityServices.map((s: any, i: number) => ({
    num: String(i + 1).padStart(2, '0'),
    title: s.title,
    desc: s.description,
    features: s.features ?? [],
    image: s.image ? urlFor(s.image).width(800).format('webp').url() : `/images/services/cosmetic.webp`,
    link: "/contact"
})) : [
    { num: "01", title: "Dentisterie esthétique", desc: "Amélioration du sourire grâce à des traitements modernes et sur mesure.", features: ["Blanchiment", "Facettes", "Couronnes"], image: "/images/services/cosmetic.webp", link: "/contact" },
    { num: "02", title: "Dentisterie restauratrice", desc: "Protégez vos dents grâce à des restaurations adaptées", features: ["Examen dentaire et nettoyage", "Soins complets", "Radiographie dentaire"], image: "/images/services/pediatrics.webp", link: "/contact" },
    { num: "03", title: "Implantologie", desc: "remplacement des dents manquantes par des implants fiables et esthétiques", features: ["Remplacement durable", "Stabilité totale", "Confort et esthétique"], image: "/images/services/restorative.webp", link: "/contact" },
    { num: "04", title: "Orthodontie", desc: "correction de l'alignement dentaire pour un sourire équilibré", features: ["Bilans orthodontiques", "Évaluations complètes", "Brackets et Gouttières"], image: "/images/services/ortho.webp", link: "/contact" }
];

const seo = servicesPage?.seo;

const servicesJsonLd = mainServices.map((s: any) => ({
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": s.title,
    "description": s.desc,
    "url": "https://www.cabinetdentairechorfi.com/services",
    "provider": {
        "@type": "Dentist",
        "name": "Cabinet Dentaire Chorfi"
    }
}));
---

<Layout
    title={seo?.metaTitle ?? "Nos Services | Cabinet Dentaire Chorfi"}
    description={seo?.metaDescription ?? "Découvrez nos soins dentaires : implants, blanchiment, orthodontie, dentisterie esthétique et restauratrice. Cabinet Dentaire Chorfi à Salé."}
    ogImage={seo?.ogImage ? urlFor(seo.ogImage).width(1200).height(630).format('webp').url() : undefined}
    noIndex={seo?.noIndex}
    jsonLd={servicesJsonLd}
    breadcrumbs={[{ name: "Services", href: "/services" }]}
>
    <Navbar />
    
    <main class="bg-white">
        {/* --- HERO SECTION --- */}
        <PageHeader title={serviceHero.title} subtitle={serviceHero.badge} />

        {/* --- VIDEO / HERO IMAGE BELOW DARK SECTION --- */}
        <div class="max-w-7xl mx-auto px-6 lg:px-8 mt-16">
            <div class="relative rounded-[2.5rem] overflow-hidden aspect-[21/9] video-container-fade shadow-2xl">
                <video
                    src={serviceHero.video}
                    poster={serviceHero.poster}
                    autoplay
                    muted
                    loop
                    playsinline
                    title="Vidéo de présentation du cabinet"
                    class="w-full h-full object-cover"
                ></video>
            </div>
        </div>

        {/* --- STATS MARQUEE --- */}
        {stats?.length > 0 && (
        <section class="py-12 border-y border-gray-100 stats-section overflow-hidden">
            <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-wrap justify-center gap-12 lg:gap-32">
                {stats.map((stat, index) => (
                    <div class="flex flex-col lg:flex-row lg:items-center gap-2 lg:gap-4 stat-item">
                        <span class="text-4xl lg:text-5xl font-bold text-[#141C18] font-bricolage">{stat.value}</span>
                        <span class="text-sm font-semibold text-gray-400 leading-tight max-w-[140px]">{stat.label}</span>
                    </div>
                ))}
            </div>
        </section>
        )}

        {/* --- DETAILED SERVICES LIST --- */}
        <section class="bg-[#F6F7F9]">
            <div class="flex flex-col">
                {mainServices.map((service, index) => (
                    <div class={`w-full py-24 lg:py-32 ${index === 0 || index === 2 ? 'bg-[#141C18]' : ''}`}>
                        <div class={`max-w-7xl mx-auto px-6 lg:px-8 flex flex-col lg:flex-row gap-12 lg:gap-24 items-center service-row ${index % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
                            {/* Content Side */}
                            <div class="flex-1 space-y-8 service-content">
                                <span class={`text-7xl lg:text-9xl font-thin font-inter leading-none block ${index === 0 || index === 2 ? 'text-white/10' : 'text-[#141C18]/10'}`}>{service.num}</span>
                                <div class="space-y-6">
                                    <h2 class={`text-4xl lg:text-5xl font-bold font-bricolage tracking-tight leading-tight ${index === 0 || index === 2 ? 'text-white' : 'text-[#141C18]'}`}>
                                        {service.title}
                                    </h2>
                                    <p class={`text-lg leading-relaxed max-w-xl ${index === 0 || index === 2 ? 'text-white/60' : 'text-gray-500'}`}>
                                        {service.desc}
                                    </p>
                                </div>
                                <ul class="space-y-4">
                                    {service.features.map(feature => (
                                        <li class={`flex items-center gap-4 font-semibold font-inter ${index === 0 || index === 2 ? 'text-white' : 'text-[#141C18]'}`}>
                                            <div class={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 ${index === 0 || index === 2 ? 'bg-[#D1F26E]' : 'bg-[#141C18]'}`}>
                                                <svg class={`w-3.5 h-3.5 ${index === 0 || index === 2 ? 'text-[#141C18]' : 'text-white'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                </svg>
                                            </div>
                                            {feature}
                                        </li>
                                    ))}
                                </ul>
                                <div class="pt-4">
                                    <a href={service.link} class="flex items-center gap-2 group cursor-pointer w-fit">
                                        <div class="bg-[#D1F26E] text-[#141C18] font-bold rounded-full text-sm flex items-center justify-center px-8 h-12 transition-colors group-hover:bg-[#c4e661]">
                                            {servicesPage?.serviceCTAText ?? "Contactez-nous"}
                                        </div>
                                        <div class="bg-[#D1F26E] text-[#141C18] w-12 h-12 rounded-full flex items-center justify-center group-hover:bg-[#c4e661] transition-colors overflow-hidden">
                                            <svg class="w-5 h-5 transition-transform duration-500 ease-out group-hover:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 19L19 5M19 5v10M19 5H9" />
                                            </svg>
                                        </div>
                                    </a>
                                </div>
                            </div>

                            {/* Image Side */}
                            <div class="flex-1 w-full service-image-wrapper">
                                <div class="relative rounded-[3rem] overflow-hidden aspect-[4/3] shadow-2xl group transition-all duration-700">
                                    <img
                                        src={service.image}
                                        alt={service.title}
                                        width="800"
                                        height="600"
                                        loading="lazy"
                                        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                                    />
                                    <div class={`absolute inset-0 transition-colors duration-700 ${index === 0 || index === 2 ? 'bg-black/20 group-hover:bg-black/10' : 'bg-black/0 group-hover:bg-black/10'}`}></div>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <ContactSection />
        <AppointmentCTA />
    </main>

    <Footer />
</Layout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    // --- HERO ANIMATIONS ---
    gsap.from('.video-container-fade', {
        scale: 0.95,
        opacity: 0,
        duration: 1.5,
        ease: 'power3.out',
        delay: 0.5
    });

    // --- STATS ANIMATION ---
    gsap.from('.stat-item', {
        scrollTrigger: {
            trigger: '.stats-section',
            start: 'top 90%',
        },
        y: 40,
        opacity: 0,
        stagger: 0.15,
        duration: 1,
        ease: 'power3.out'
    });

    // --- SERVICE ROWS ANIMATION ---
    const serviceRows = document.querySelectorAll('.service-row');
    serviceRows.forEach((row) => {
        const content = row.querySelector('.service-content');
        const image = row.querySelector('.service-image-wrapper');
        const num = row.querySelector('.service-content span');

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: row,
                start: 'top 75%',
            }
        });

        tl.from(num, { opacity: 0, y: 40, duration: 1 })
          .from(content.querySelectorAll('h2, p, ul, div'), { 
             y: 30, 
             opacity: 0, 
             stagger: 0.1, 
             duration: 0.8,
             ease: 'power2.out'
          }, '-=0.6')
          .from(image, { 
             scale: 0.8, 
             opacity: 0, 
             duration: 1.2, 
             ease: 'expo.out' 
          }, '-=0.8');
    });
</script>
