---
import { getSiteSettings } from '../lib/queries';

const settings = await getSiteSettings();

const aboutText = settings?.aboutText ?? 'Le Cabinet Dentaire Chorfi à Salé vous offre des soins dentaires complets et de haute qualité. Le Dr Zainab Chorfi vous accueille dans un environnement confortable pour vos traitements en omnipratique, en esthétique dentaire et en prévention.';

const phones = settings?.phones ?? ['0644801152', '0538716787'];
const rawAddress = settings?.address;
const address = typeof rawAddress === 'object' && rawAddress !== null
  ? [rawAddress.street, rawAddress.floor, rawAddress.city].filter(Boolean).join(', ')
  : rawAddress ?? 'Avenue Moulay Youssef n° 19, 1er étage, Tabriquet, Salé';

const businessHours = settings?.businessHours ?? [
    { days: 'Lundi – Vendredi', hours: '09h - 13h | 15h - 19h', isClosed: false },
    { days: 'Samedi', hours: '09h - 13h', isClosed: false },
    { days: 'Dimanche', hours: 'Fermé', isClosed: true }
];

const socialLinks = settings?.socialLinks ?? [
    { platform: 'instagram', url: 'https://www.instagram.com/cabinet.dentaire.chorfi/' },
    { platform: 'facebook', url: 'https://www.facebook.com/61576404963248/about/' },
    { platform: 'whatsapp', url: 'https://wa.me/212644801152' },
    { platform: 'dentisto', url: 'https://dentisto.ma/rendez-vous/docteurs/chorfi-zainab-2520' }
];

const instagramUrl = socialLinks.find((s: any) => s.platform === 'instagram')?.url ?? 'https://www.instagram.com/cabinet.dentaire.chorfi/';
const facebookUrl = socialLinks.find((s: any) => s.platform === 'facebook')?.url ?? 'https://www.facebook.com/61576404963248/about/';
const whatsappUrl = socialLinks.find((s: any) => s.platform === 'whatsapp')?.url ?? 'https://wa.me/212644801152';
const dentistoUrl = socialLinks.find((s: any) => s.platform === 'dentisto')?.url ?? 'https://dentisto.ma/rendez-vous/docteurs/chorfi-zainab-2520';

const googleMapsUrl = settings?.googleMapsUrl ?? 'https://www.google.com/maps/place/CABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab/@34.0377681,-6.8033237,17z/data=!4m16!1m9!3m8!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!2sCABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab!8m2!3d34.0378219!4d-6.803389!9m1!1b1!16s%2Fg%2F11x8_5f85j!3m5!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!8m2!3d34.0378219!4d-6.803389!16s%2Fg%2F11x8_5f85j?entry=ttu&g_ep=EgoyMDI2MDIyNS4wIKXMDSoASAFQAw%3D%3D';

const defaultNavLinks = [
    { href: '/', label: 'Accueil' },
    { href: '/qui-sommes-nous', label: 'Le cabinet' },
    { href: '/services', label: 'Nos soins' },
    { href: '/blog', label: 'Articles' },
    { href: '/contact', label: 'Contact' }
];
---

<div class="bg-white">
  <footer class="bg-oralix-dark text-white pt-24 pb-12 rounded-t-[3rem]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    <div class="flex flex-col lg:flex-row justify-between items-center lg:items-start gap-16 mb-20 relative z-10 text-center lg:text-left">
      
      <!-- A propos -->
      {(settings?.footerAboutTitle !== null) && (
      <div class="max-w-md w-full flex flex-col items-center lg:items-start">
        <h2 class="font-bricolage text-2xl font-semibold mb-6 text-oralix-brand uppercase tracking-wider">{settings?.footerAboutTitle ?? "À propos"}</h2>
        <p class="text-white/80 mb-10 leading-relaxed">
          {aboutText}
        </p>

        <img src="/logo.webp" alt="Cabinet Dentaire Chorfi" class="h-16 w-auto" />
      </div>
      )}

      <!-- Links Grid -->
      <div class="flex-grow grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-8 w-full">
        
        <!-- Navigation -->
        {(settings?.footerNavTitle !== null) && (
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <h3 class="font-bricolage text-xl font-semibold mb-6 text-white uppercase tracking-tight">{settings?.footerNavTitle ?? "Navigation"}</h3>
          <ul class="space-y-4 font-inter text-white/70">
            {(settings?.navLinks?.length ? settings.navLinks : defaultNavLinks).map((link: any) => (
              <li><a href={link.href} class="hover:text-oralix-brand transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>
        )}
        
        <!-- Horaires -->
        {(settings?.footerHoraireTitle !== null) && (
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <h3 class="font-bricolage text-xl font-semibold mb-6 text-white uppercase tracking-tight">{settings?.footerHoraireTitle ?? "Horaires"}</h3>
          <ul class="space-y-3 font-inter text-white/70 text-sm">
            {businessHours.map((h: any) => (
              <li class="flex flex-col">
                <span class={`text-white font-medium ${h.isClosed ? 'text-red-400' : ''}`}>{h.days}</span>
                <span>{h.hours}</span>
              </li>
            ))}
          </ul>
        </div>
        )}

        <!-- Contact -->
        {(settings?.footerContactTitle !== null) && (
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <h3 class="font-bricolage text-xl font-semibold mb-6 text-white uppercase tracking-tight">{settings?.footerContactTitle ?? "Contact"}</h3>
          <div class="space-y-8">
            <div class="space-y-6">
              <div class="space-y-3 w-full">
                {phones.map((phone: string, i: number) => (
                  <a href={`tel:${phone}`} class="flex items-center justify-center lg:justify-start gap-3 text-white/70 hover:text-oralix-brand transition-colors group">
                    <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center border border-white/10 group-hover:border-oralix-brand/50 transition-colors">
                      {i === 0 ? (
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                      ) : (
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                      )}
                    </div>
                    <span class="font-inter font-medium group-hover:text-white">{phone}</span>
                  </a>
                ))}
              </div>

              <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center md:items-start md:flex-row gap-4 text-white/70 hover:text-oralix-brand transition-colors group pt-4 border-t border-white/5">
                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center border border-white/10 group-hover:border-oralix-brand/50 grow-0 shrink-0 text-oralix-brand transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <p class="text-xs font-inter leading-relaxed group-hover:text-white transition-colors text-center lg:text-left">
                  {address}
                </p>
              </a>
            </div>

            <div class="flex items-center justify-center lg:justify-start gap-3 pt-2">
              <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-oralix-brand hover:text-oralix-dark transition-all border border-white/10" aria-label="Instagram">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
              <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-oralix-brand hover:text-oralix-dark transition-all border border-white/10" aria-label="Facebook">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-oralix-brand hover:text-oralix-dark transition-all border border-white/10" aria-label="WhatsApp">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.01 2.002c-5.523 0-10.002 4.478-10.002 10.002 0 1.966.568 3.805 1.55 5.334L2.001 22l4.825-1.503c1.474.887 3.232 1.401 5.084 1.401 5.522 0 10.001-4.478 10.001-10.002S17.532 2.002 12.01 2.002zm0 18.003c-1.571 0-3.05-.403-4.341-1.116l-.312-.186-3.14.978.995-3.03-.205-.327a8.552 8.552 0 0 1-1.353-4.536c0-4.664 3.79-8.455 8.455-8.455 4.665 0 8.455 3.791 8.455 8.455 0 4.663-3.79 8.454-8.455 8.454zm4.453-6.262c-.244-.122-1.442-.713-1.666-.795-.224-.082-.387-.122-.55.122-.163.245-.631.795-.774.958-.142.163-.285.184-.53.061-.244-.122-1.028-.379-1.956-1.206-.723-.644-1.21-1.44-1.353-1.684-.143-.245-.015-.377.107-.499.11-.11.245-.285.366-.428.123-.143.163-.245.245-.408.082-.163.041-.306-.02-.428-.061-.122-.55-1.326-.754-1.816-.199-.479-.402-.414-.55-.421-.143-.007-.306-.008-.469-.008s-.428.061-.652.306c-.224.245-.856.836-.856 2.039 0 1.203.876 2.366.998 2.529.123.163 1.724 2.632 4.175 3.692.583.253 1.038.404 1.393.516.586.186 1.12.16 1.543.097.472-.07 1.442-.59 1.646-1.161.204-.571.204-1.06.143-1.161-.061-.102-.224-.163-.469-.286z"/></svg>
              </a>
              <a href={dentistoUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-oralix-brand hover:text-oralix-dark transition-all border border-white/10" aria-label="Appointment">
                <svg class="w-4 h-4 fill-current rotate-[180deg]" viewBox="0 0 512 512">
                    <path d="M141.8 494.5c-15.7-2.5-31.9-9-46.5-18.7-10-6.7-26.2-22.9-33.8-33.7-21.8-31.2-33.4-77.4-28.4-113.8 3-22.4 8.8-37.7 32.3-85.1 20.9-42.1 29.2-60.2 52.8-115.2 33.4-77.7 45.9-98.5 65.4-108.1 6.5-3.2 7.4-3.4 17.4-3.4 12.7.1 18.7 2.2 25.1 9.2 10.4 11.3 13.9 31.1 13.9 78.2 0 38.6 2.4 64.2 7 73.6 4.2 8.7 13.8 8.7 18 0 4.6-9.4 7-35 7-73.6 0-47.1 3.5-66.9 13.9-78.2 6.4-7 12.4-9.1 25.1-9.2 10 0 10.9.2 17.4 3.4 19.5 9.6 31.9 30.2 65.4 108.1 23.8 55.2 32 73.2 52.8 115.2 10 20.2 20 41.4 22.2 47 9.8 25.7 12.8 47.1 10.2 72.8-5.6 54-34 99.3-75.6 120.6-21.5 10.9-44.4 14.5-69.2 10.8-19.1-2.8-37-9.6-53.7-20.4-10.7-7-16.2-9-24.5-9-8.3 0-13.8 2-24.7 9.1-27.3 17.7-59.6 25-89.5 20.4zm35.2-16c17.4-2.9 32.5-9 49-20 15.6-10.3 31.7-17 51.1-21.2 10.5-2.2 45.2-2.5 56.9-.5 8.2 1.5 30.1 6.9 30.8 7.7.5.4-3.8 15.5-4.3 15.5-.1 0-2.7-.9-5.8-1.9-14.3-5-26.1-6.6-47.2-6.5-11 .1-22 .5-24.4 1l-4.4.9 8.4 5.7c10.7 7.1 18.7 11.1 29.7 14.8 30.1 10.1 60 7.1 86.4-8.6 11.1-6.6 28.6-23.8 36.3-35.7 10.5-16.3 17.5-33.9 21.7-54.9 1.8-9.1 2.2-14.8 2.2-28.8 0-15.7-.2-18.6-2.6-28.2-4.2-16.5-7.5-24.2-28.8-67.8-22.9-46.8-29-60-52.2-114-35.8-83.4-47.5-101.8-66-103.7-14.5-1.5-20.7 5.3-23.8 26.2-.6 3.9-1.5 25.7-2 48.5-.9 43.3-2.3 59.2-6 71.1-2.8 9.1-7 15.2-12.7 18.6-4.3 2.5-5.8 2.8-13.3 2.8-7.5 0-9-.3-13.3-2.8-5.7-3.4-9.9-9.5-12.7-18.6-3.7-11.9-5.1-27.8-6-71.1-.5-22.8-1.4-44.6-2-48.5-3.1-20.9-9.3-27.7-23.8-26.2-18.5 1.9-30.3 20.5-66.1 103.8-23.6 54.9-29.4 67.6-52.1 113.9-20.9 42.5-24.6 51.1-28.6 67.5-8.6 34.8-.2 79.4 21.1 112.2 7.8 12 25.2 29.2 36.3 35.7 21.3 12.6 44 17 68.2 13.1z"/><path d="M153.5 462.5c-33.3-6.1-62.5-30.4-77-64.1-6.1-14.2-11-34.6-11.7-48.4l-.3-5.5 7.6-.5 7.6-.5 1.6 11.5c4.3 30.5 13.6 51.1 30.7 68 13.3 13.2 29.4 21.2 48.7 24.2l7.3 1.2v7.8v7.8l-3.7-.1c-2.1 0-6.9-.7-10.8-1.4z"/><path d="M430.7 334.5c-4.1-22.9-14.8-48-31.3-73.2-3-4.4-5.4-8.3-5.4-8.6 0-.6 9.7-7.7 11.6-8.4 2-7 14.1 18.3 23.4 36.9 8.5 17.1 15.1 36 17.5 50.2 2.3 13.5 2.8 12.6-6.3 12.6h-7.8l-1.7-9.5z"/><path d="M64 320v-8h8h8v8v8h-8h-8v-8z"/></svg>
                </a>
            </div>
          </div>
        </div>
        )}

      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col-reverse lg:flex-row justify-between items-center gap-6 relative z-10 text-center lg:text-left">
      <div class="space-y-1">
        <p class="font-inter text-white/50 text-sm">
          <Fragment set:html={settings?.footerCopyright ?? '© 2026 Cabinet Dentaire Chorfi | Tous droits réservés. Conçu par <a href="https://wa.me/212611714711" target="_blank" rel="noopener noreferrer" class="text-white font-medium hover:text-oralix-brand transition-colors">MouaDev</a> - <a href="https://www.instagram.com/hosniayoub_?utm_source=qr" target="_blank" rel="noopener noreferrer" class="text-white font-medium hover:text-oralix-brand transition-colors">Ayoub HOSNI</a>.'} />
        </p>
      </div>
      
      <div class="flex flex-wrap justify-center lg:justify-end items-center gap-6 lg:gap-8 font-inter text-sm text-white/50">
        <a href="/politique-de-confidentialite" class="hover:text-oralix-brand transition-colors">Politique de confidentialité</a>
        <a href="/plan-du-site" class="hover:text-oralix-brand transition-colors">Plan du site</a>
      </div>
    </div>
  </div>
  
  <!-- Subtle Background Pattern/Gradient (Optional, matching oralix style) -->
  <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-oralix-brand/5 to-transparent pointer-events-none rounded-t-[3rem]"></div>
</footer>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animate footer elements on scroll
  gsap.from("footer .max-w-md > *", {
    y: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: "power3.out",
    scrollTrigger: {
      trigger: "footer",
      start: "top 80%",
    }
  });

  gsap.from("footer .grid > div", {
    y: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: "power3.out",
    delay: 0.2,
    scrollTrigger: {
      trigger: "footer",
      start: "top 80%",
    }
  });
</script>
