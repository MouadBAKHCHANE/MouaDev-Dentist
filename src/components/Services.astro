---
import { urlFor } from '../lib/sanity';
import { getServices, getHomePage } from '../lib/queries';

const sanityServices = await getServices();
const homePage = await getHomePage();

const services = sanityServices?.length ? sanityServices.map((s: any, i: number) => ({
    num: String(i + 1).padStart(2, '0'),
    title: s.title,
    image: s.image ? urlFor(s.image).width(800).format('webp').url() : `/images/services/cosmetic.webp`,
    desc: s.description,
    list: s.features ?? []
})) : [
  {
    num: "01",
    title: "Dentisterie esthétique",
    image: "/images/services/cosmetic.webp",
    desc: "Amélioration du sourire grâce à des traitements modernes et sur mesure.",
    list: ["Blanchiment", "Facettes", "Couronnes"]
  },
  {
    num: "02",
    title: "Dentisterie restauratrice",
    image: "/images/services/pediatrics.webp",
    desc: "Protégez vos dents grâce à des restaurations adaptées",
    list: ["Examen dentaire et nettoyage", "Soins complets", "Radiographie dentaire"]
  },
  {
    num: "03",
    title: "Implantologie",
    image: "/images/services/restorative.webp",
    desc: "remplacement des dents manquantes par des implants fiables et esthétiques, pour un confort et une stabilité à long terme",
    list: ["Remplacement durable", "Stabilité totale", "Confort et esthétique"]
  },
  {
    num: "04",
    title: "Orthodontie",
    image: "/images/services/ortho.webp",
    desc: "correction de l'alignement dentaire pour un sourire équilibré et une meilleure santé bucco-dentaire",
    list: ["Bilans orthodontiques", "Évaluations complètes", "Brackets et Gouttières"]
  }
];
---

<section class="py-24 bg-[#F6F7F9] relative z-20" id="services">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        
        {/* Header */}
        <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-16 gap-8 service-header">
            <div>
                {homePage?.servicesBadge && (
                <div class="inline-flex items-center gap-2 mb-6 text-gray-500 font-medium text-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                    {homePage?.servicesBadge ?? "Nos soins"}
                </div>
                )}
                <h2 class="text-4xl lg:text-[3.5rem] font-medium text-[#141C18] leading-tight font-bricolage tracking-tight">
                    {homePage?.servicesTitle ?? "Nos soins"}
                </h2>
            </div>
            {/* Split Button Pill style */}
            {homePage?.servicesButtonText && (
            <div class="flex items-center gap-2 group cursor-pointer w-fit" onclick={`window.location.href='${homePage?.servicesButtonLink ?? "/services"}'`}>
                <a href={homePage?.servicesButtonLink ?? "/services"} class="bg-[#cbfb45] text-[#141C18] font-medium rounded-full text-sm block overflow-hidden h-12 w-[200px] relative transition-colors group-hover:bg-[#bdf333]">
                    <div class="absolute inset-0 flex flex-col h-[200%] w-full transition-transform duration-500 ease-[cubic-bezier(0.87,0,0.13,1)] group-hover:-translate-y-1/2">
                        <span class="flex items-center justify-center h-12 w-full">{homePage?.servicesButtonText ?? "Voir Tous Les Services"}</span>
                        <span class="flex items-center justify-center h-12 w-full">{homePage?.servicesButtonText ?? "Voir Tous Les Services"}</span>
                    </div>
                </a>
                <a href={homePage?.servicesButtonLink ?? "/services"} class="relative overflow-hidden bg-[#cbfb45] text-[#141C18] w-12 h-12 rounded-full flex items-center justify-center group-hover:bg-[#bdf333] transition-colors">
                    <svg class="w-5 h-5 transition-transform duration-500 ease-out group-hover:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19L19 5M19 5v10M19 5H9" />
                    </svg>
                </a>
            </div>
            )}
        </div>

        {/* Services List */}
        <div class="flex flex-col gap-4 relative">
            {services.map((service) => (
                <div class="group bg-white hover:bg-[#141C18] rounded-3xl p-8 lg:p-10 border border-black/5 hover:border-transparent transition-all duration-300 service-card flex flex-col lg:flex-row gap-8 lg:gap-12 lg:items-start cursor-pointer relative overflow-visible z-10">
                    
                    {/* Hover Background Image (Mobile Only) */}
                    <div class="absolute inset-0 z-0 opacity-0 group-hover:opacity-100 lg:hidden transition-opacity duration-500 rounded-3xl overflow-hidden pointer-events-none mobile-bg-layer">
                        <img src={service.image} alt={service.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-[#141C18]/80"></div>
                    </div>
                    
                    {/* Hover Image Container */}
                    <div class="service-hover-img absolute pointer-events-none opacity-0 scale-75 z-50 w-64 h-48 lg:w-80 lg:h-56 rounded-2xl overflow-hidden shadow-2xl border-4 border-white transform origin-center rotate-[-10deg]">
                        <img src={service.image} alt={service.title} class="w-full h-full object-cover" />
                    </div>

                    {/* Left: Number */}
                    <div class="text-[#141C18] group-hover:text-white/50 font-medium text-lg w-12 shrink-0 transition-colors duration-300 relative z-10">
                        {service.num}
                    </div>
                    
                    {/* Middle Left: Title & Description */}
                    <div class="flex-1 lg:max-w-md flex flex-col gap-4 relative z-10">
                        <h3 class="text-2xl lg:text-3xl font-semibold text-[#141C18] group-hover:text-white font-bricolage tracking-tight transition-colors duration-300">
                            {service.title}
                        </h3>
                        <p class="text-gray-500 group-hover:text-white/60 leading-relaxed font-inter text-[15px] transition-colors duration-300">
                            {service.desc}
                        </p>
                    </div>

                    {/* Middle Right: List */}
                    <div class="flex-1 lg:max-w-sm mt-4 lg:mt-0 flex items-center border-l lg:border-l-0 lg:border-r border-gray-100 lg:group-hover:border-white/10 pl-4 lg:pl-0 lg:pr-12 relative z-10 transition-colors duration-300">
                        <ul class="space-y-4">
                            {service.list.map(item => (
                                <li class="flex items-center text-[15px] text-[#141C18] group-hover:text-white font-medium gap-3 transition-colors duration-300">
                                    <div class="w-5 h-5 rounded-full bg-[#141C18] group-hover:bg-white flex items-center justify-center shrink-0 transition-colors duration-300">
                                        <svg class="w-3 h-3 text-white group-hover:text-[#141C18] transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                        </svg>
                                    </div>
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>

                    {/* Right: Arrow Button */}
                    <div class="lg:w-16 flex justify-end lg:ml-auto mt-4 lg:mt-0 items-center relative z-10">
                         <div class="w-12 h-12 rounded-full border border-gray-200 group-hover:border-white/20 flex items-center justify-center group-hover:bg-[#cbfb45] transition-all duration-300">
                             <svg class="w-5 h-5 text-[#141C18] group-hover:text-[#141C18] transition-all duration-300 group-hover:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19L19 5M19 5v10M19 5H9" />
                             </svg>
                         </div>
                    </div>
                    
                </div>
            ))}
        </div>

    </div>
</section>

<style>
    .service-hover-img {
        pointer-events: none;
        position: absolute;
        top: 50%;
        right: 2%;
        z-index: 50;
        width: 320px; /* lg:w-80 */
        height: 224px; /* lg:h-56 */
        border-radius: 1rem;
        overflow: hidden;
        border: 4px solid white;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        opacity: 0;
        transform: translateY(-50%) scale(0.8) rotate(-10deg);
        visibility: hidden;
        will-change: filter, transform, opacity;
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
    }

    @media (max-width: 1024px) {
        .service-hover-img {
            display: none;
        }

        /* Mobile Active State Styles */
        .service-card.active {
            background-color: #141C18 !important;
            border-color: transparent !important;
        }

        .service-card.active .mobile-bg-layer {
            opacity: 1 !important;
        }

        .service-card.active h3,
        .service-card.active .text-lg {
            color: #FFFFFF !important;
        }

        .service-card.active p,
        .service-card.active ul li {
            color: rgba(255, 255, 255, 0.7) !important;
        }

        .service-card.active ul li svg {
            color: #141C18 !important;
        }

        .service-card.active ul li div {
            background-color: #FFFFFF !important;
        }

        .service-card.active .w-12.h-12.rounded-full.border {
            border-color: rgba(255, 255, 255, 0.2) !important;
            background-color: #cbfb45 !important;
        }
    }
</style>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Fade up cards on scroll
    const serviceCards = document.querySelectorAll('.service-card');
    
    serviceCards.forEach((card, index) => {
        gsap.from(card, {
            scrollTrigger: {
                trigger: card,
                start: 'top 90%',
                once: true,
            },
            y: 50,
            autoAlpha: 0,
            duration: 0.8,
            delay: index * 0.1,
            ease: 'expo.out'
        });
    });

    // Mouse movement for hover images
    const section = document.querySelector('#services');
    const cards = document.querySelectorAll('.service-card');
    
    if (section && cards.length > 0) {
        cards.forEach(card => {
            const img = card.querySelector('.service-hover-img');
            if (!img) return;
            
            card.addEventListener('mouseenter', () => {
                gsap.set(section, { zIndex: 40 });
                gsap.set(card, { zIndex: 50 });
                
                gsap.to(img, {
                    autoAlpha: 1,
                    scale: 1,
                    rotate: -8,
                    duration: 0.25,
                    ease: 'expo.out'
                });
            });

            card.addEventListener('mouseleave', () => {
                 gsap.to(img, {
                    autoAlpha: 0,
                    scale: 0.9,
                    rotate: -10,
                    x: 0,
                    y: 0,
                    duration: 0.2,
                    ease: 'power2.out',
                    onComplete: () => {
                        gsap.set(card, { zIndex: 10 });
                        const isAnyCardHovered = Array.from(cards).some(c => c.matches(':hover'));
                        if (!isAnyCardHovered) {
                             gsap.set(section, { zIndex: 20 });
                        }
                    }
                });
            });
        });
    }

    const serviceHeader = document.querySelector('.service-header');
    if (serviceHeader) {
        gsap.from(serviceHeader, {
            scrollTrigger: {
                trigger: '#services',
                start: 'top 85%',
                once: true,
            },
            y: 30,
            autoAlpha: 0,
            duration: 1,
            ease: 'expo.out'
        });
    }

    // Mobile Scroll Activation Logic
    if (window.matchMedia('(max-width: 1024px)').matches) {
        const observerOptions = {
            root: null,
            rootMargin: '-30% 0px -30% 0px', // More balanced for Safari
            threshold: 0.5 // Lower threshold for better reliability
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Remove active from all others
                    serviceCards.forEach(c => c.classList.remove('active'));
                    // Add to current
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        serviceCards.forEach(card => observer.observe(card));
    }
</script>
