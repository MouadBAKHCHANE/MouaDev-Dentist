                    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-oralix-brand transition-all hover:scale-110" aria-label="WhatsApp">
                    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24"><path d="M12.01 2.002c-5.523 0-10.002 4.478-10.002 10.002 0 1.966.568 3.805 1.55 5.334L2.001 22l4.825-1.503c1.474.887 3.232 1.401 5.084 1.401 5.522 0 10.001-4.478 10.001-10.002S17.532 2.002 12.01 2.002zm0 18.003c-1.571 0-3.05-.403-4.341-1.116l-.312-.186-3.14.978.995-3.03-.205-.327a8.552 8.552 0 0 1-1.353-4.536c0-4.664 3.79-8.455 8.455-8.455 4.665 0 8.455 3.791 8.455 8.455 0 4.663-3.79 8.454-8.455 8.454zm4.453-6.262c-.244-.122-1.442-.713-1.666-.795-.224-.082-.387-.122-.55.122-.163.245-.631.795-.774.958-.142.163-.285.184-.53.061-.244-.122-1.028-.379-1.956-1.206-.723-.644-1.21-1.44-1.353-1.684-.143-.245-.015-.377.107-.499.11-.11.245-.285.366-.428.123-.143.163-.245.245-.408.082-.163.041-.306-.02-.428-.061-.122-.55-1.326-.754-1.816-.199-.479-.402-.414-.55-.421-.143-.007-.306-.008-.469-.008s-.428.061-.652.306c-.224.245-.856.836-.856 2.039 0 1.203.876 2.366.998 2.529.123.163 1.724 2.632 4.175 3.692.583.253 1.038.404 1.393.516.586.186 1.12.16 1.543.097.472-.07 1.442-.59 1.646-1.161.204-.571.204-1.06.143-1.161-.061-.102-.224-.163-.469-.286z"/></svg>
                </a>
                <a href={dentistoUrl} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-oralix-brand transition-all hover:scale-110" aria-label="Appointment">
                    <svg class="w-7 h-7 fill-current rotate-[180deg]" viewBox="0 0 512 512"><path d="M141.8 494.5c-15.7-2.5-31.9-9-46.5-18.7-10-6.7-26.2-22.9-33.8-33.7-21.8-31.2-33.4-77.4-28.4-113.8 3-22.4 8.8-37.7 32.3-85.1 20.9-42.1 29.2-60.2 52.8-115.2 33.4-77.7 45.9-98.5 65.4-108.1 6.5-3.2 7.4-3.4 17.4-3.4 12.7.1 18.7 2.2 25.1 9.2 10.4 11.3 13.9 31.1 13.9 78.2 0 38.6 2.4 64.2 7 73.6 4.2 8.7 13.8 8.7 18 0 4.6-9.4 7-35 7-73.6 0-47.1 3.5-66.9 13.9-78.2 6.4-7 12.4-9.1 25.1-9.2 10 0 10.9.2 17.4 3.4 19.5 9.6 31.9 30.2 65.4 108.1 23.8 55.2 32 73.2 52.8 115.2 10 20.2 20 41.4 22.2 47 9.8 25.7 12.8 47.1 10.2 72.8-5.6 54-34 99.3-75.6 120.6-21.5 10.9-44.4 14.5-69.2 10.8-19.1-2.8-37-9.6-53.7-20.4-10.7-7-16.2-9-24.5-9-8.3 0-13.8 2-24.7 9.1-27.3 17.7-59.6 25-89.5 20.4zm35.2-16c17.4-2.9 32.5-9 49-20 15.6-10.3 31.7-17 51.1-21.2 10.5-2.2 45.2-2.5 56.9-.5 8.2 1.5 30.1 6.9 30.8 7.7.5.4-3.8 15.5-4.3 15.5-.1 0-2.7-.9-5.8-1.9-14.3-5-26.1-6.6-47.2-6.5-11 .1-22 .5-24.4 1l-4.4.9 8.4 5.7c10.7 7.1 18.7 11.1 29.7 14.8 30.1 10.1 60 7.1 86.4-8.6 11.1-6.6 28.6-23.8 36.3-35.7 10.5-16.3 17.5-33.9 21.7-54.9 1.8-9.1 2.2-14.8 2.2-28.8 0-15.7-.2-18.6-2.6-28.2-4.2-16.5-7.5-24.2-28.8-67.8-22.9-46.8-29-60-52.2-114-35.8-83.4-47.5-101.8-66-103.7-14.5-1.5-20.7 5.3-23.8 26.2-.6 3.9-1.5 25.7-2 48.5-.9 43.3-2.3 59.2-6 71.1-2.8 9.1-7 15.2-12.7 18.6-4.3 2.5-5.8 2.8-13.3 2.8-7.5 0-9-.3-13.3-2.8-5.7-3.4-9.9-9.5-12.7-18.6-3.7-11.9-5.1-27.8-6-71.1-.5-22.8-1.4-44.6-2-48.5-3.1-20.9-9.3-27.7-23.8-26.2-18.5 1.9-30.3 20.5-66.1 103.8-23.6 54.9-29.4 67.6-52.1 113.9-20.9 42.5-24.6 51.1-28.6 67.5-8.6 34.8-.2 79.4 21.1 112.2 7.8 12 25.2 29.2 36.3 35.7 21.3 12.6 44 17 68.2 13.1z"/></svg>
