---
import { urlFor } from '../lib/sanity';
import { getSiteSettings } from '../lib/queries';

const settings = await getSiteSettings();

const logoSrc = settings?.logo?.asset ? urlFor(settings.logo).height(72).format('webp').url() : '/logo.webp';
const appointmentUrl = settings?.appointmentUrl ?? '/contact';
const whatsappNumber = settings?.whatsappNumber ?? '212644801152';
const googleMapsUrl = settings?.googleMapsUrl ?? 'https://www.google.com/maps/place/CABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab/@34.0377681,-6.8033237,17z/data=!4m16!1m9!3m8!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!2sCABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab!8m2!3d34.0378219!4d-6.803389!9m1!1b1!16s%2Fg%2F11x8_5f85j!3m5!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!8m2!3d34.0378219!4d-6.803389!16s%2Fg%2F11x8_5f85j?entry=ttu&g_ep=EgoyMDI2MDIyNS4wIKXMDSoASAFQAw%3D%3D';

const defaultNavLinks = [
    { href: '/', label: 'Accueil' },
    { href: '/qui-sommes-nous', label: 'Le cabinet' },
    { href: '/services', label: 'Nos soins' },
    { href: '/blog', label: 'Articles' },
    { href: '/contact', label: 'Contact' }
];
const navLinks = settings?.navLinks?.length ? settings.navLinks : defaultNavLinks;

const socialLinks = settings?.socialLinks ?? [
    { platform: 'instagram', url: 'https://www.instagram.com/cabinet.dentaire.chorfi/' },
    { platform: 'facebook', url: 'https://www.facebook.com/61576404963248/about/' },
    { platform: 'whatsapp', url: `https://wa.me/${whatsappNumber}` },
    { platform: 'dentisto', url: 'https://dentisto.ma/rendez-vous/docteurs/chorfi-zainab-2520' }
];

const instagramUrl = socialLinks.find((s: any) => s.platform === 'instagram')?.url ?? 'https://www.instagram.com/cabinet.dentaire.chorfi/';
const facebookUrl = socialLinks.find((s: any) => s.platform === 'facebook')?.url ?? 'https://www.facebook.com/61576404963248/about/';
const whatsappUrl = socialLinks.find((s: any) => s.platform === 'whatsapp')?.url ?? `https://wa.me/${whatsappNumber}`;
const dentistoUrl = socialLinks.find((s: any) => s.platform === 'dentisto')?.url ?? 'https://dentisto.ma/rendez-vous/docteurs/chorfi-zainab-2520';
---
<nav class="fixed top-0 left-0 w-full z-50 py-3" id="navbar" style="background-color: transparent; transition: all 0.3s ease;">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between">
        
        {/* Logo - Start */}
        <div class="flex-1 lg:w-1/3 flex justify-start">
            <a href="/" class="flex-shrink-0 flex items-center gap-2">
                <img src={logoSrc} alt="Cabinet Dentaire Chorfi" id="main-logo" class="h-14 lg:h-18 w-auto transition-all duration-300" style="filter: brightness(0) invert(1);" />
            </a>
        </div>

        {/* Desktop Menu - Center */}
        <div class="hidden lg:flex w-1/3 justify-center">
            <div class="flex items-center space-x-6 lg:space-x-8">
                {navLinks.map((link: any, i: number) => (
                    <a href={link.href} class={`${i === 0 ? 'text-white' : 'text-white/90'} hover:text-oralix-brand transition-colors text-sm font-medium whitespace-nowrap`}>{link.label}</a>
                ))}
            </div>
        </div>

        {/* CTA Button & Mobile Toggle - End */}
        <div class="flex-1 lg:w-1/3 flex justify-end items-center gap-4">
            <div class="hidden lg:flex items-center gap-3">
                <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-white/20 text-white hover:bg-white hover:text-oralix-dark transition-all duration-300 group" title="Localisation">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </a>
                <a href="/contact" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 border border-transparent text-sm font-semibold rounded-full text-oralix-dark bg-oralix-brand hover:scale-105 transition-transform group whitespace-nowrap">
                    {settings?.ctaButtonText ?? "Prendre Rendez-vous"}
                    <svg class="w-3.5 h-3.5 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </div>

            {/* Mobile menu button */}
            <div class="lg:hidden flex justify-end items-center">
                <button type="button" class="text-white hover:text-oralix-brand focus:outline-none py-2 pl-2 pr-0 relative z-[60]" id="mobile-menu-button" aria-label="Toggle Menu">
                    <svg class="h-8 w-8 transition-all duration-300" id="hamburger-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
                    </svg>
                    <svg class="h-8 w-8 absolute top-2 right-0 opacity-0 scale-50 transition-all duration-300" id="close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</nav>

{/* Mobile Menu Overlay */}
    <div class="fixed inset-0 bg-oralix-dark z-[55] translate-x-full transition-transform duration-500 ease-out lg:hidden flex flex-col pt-10 px-6 overflow-y-auto" id="mobile-menu">
        {/* Mobile Menu Logo */}
        <div class="flex justify-center mb-12 mobile-menu-item opacity-0">
             <img src={logoSrc} alt="Cabinet Dentaire Chorfi" class="h-24 w-auto brightness-0 invert" />
        </div>

        <div class="flex flex-col space-y-6 text-center mb-10">
            {navLinks.map((link: any) => (
                <a href={link.href} class="mobile-link mobile-menu-item opacity-0 text-white text-3xl font-semibold hover:text-oralix-brand transition-colors">{link.label}</a>
            ))}
        </div>

        <div class="mt-auto pb-12 flex flex-col items-center space-y-10 mobile-menu-item opacity-0">
            <div class="flex flex-col items-center gap-4 w-full px-6">
