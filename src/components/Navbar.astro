<style>
    /* Mobile Menu Toggle Animation */
    
    :global(#navbar.menu-open-nav) {
        z-index: 60 !important;
        background-color: transparent !important;
        backdrop-filter: none !important;
        box-shadow: none !important;
        border-bottom: none !important;
    }
    
    :global(#navbar.menu-open-nav #main-logo) {
        opacity: 0 !important;
    }
    
    :global(#mobile-menu-button.menu-active #hamburger-icon) {
        opacity: 0;
        transform: scale(0.5) rotate(90deg);
    }
    
    :global(#mobile-menu-button.menu-active #close-icon) {
        opacity: 1;
        transform: scale(1) rotate(0);
    }

    /* When navbar gets the .scrolled class, turn the logo black */
    :global(#navbar.scrolled #main-logo) {
        filter: brightness(0) invert(0) !important;
    }
    
    /* Make text links and icons dark when scrolled (only if menu is closed) */
    :global(#navbar.scrolled:not(.menu-open-nav) a),
    :global(#navbar.scrolled:not(.menu-open-nav) button) {
        color: #0D1B15 !important;
    }
    
    /* Ensure the CTA button text stays dark and doesn't get messed up */
    :global(#navbar.scrolled .bg-oralix-brand) {
        color: #0D1B15 !important;
    }
</style>

<script>
    import gsap from 'gsap';

    // Navbar scroll effect
    const navbar = document.getElementById('navbar');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    
    function toggleMenu() {
        const isOpen = mobileMenu.classList.toggle('menu-open');
        mobileMenu.classList.toggle('translate-x-full');
        mobileMenu.classList.toggle('translate-x-0');
        mobileMenuButton.classList.toggle('menu-active');
        navbar.classList.toggle('menu-open-nav');
        
        // Disable body scroll when menu is open
        document.body.style.overflow = isOpen ? 'hidden' : '';

        // Staggered animation for menu items
        if (isOpen) {
            gsap.fromTo('.mobile-menu-item', 
                { y: 30, opacity: 0 }, 
                { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: 'power3.out', delay: 0.2 }
            );
        } else {
            // Re-hide items when menu closes to reset state
            gsap.to('.mobile-menu-item', { opacity: 0, duration: 0.3 });
        }
    }

    mobileMenuButton.addEventListener('click', toggleMenu);

    // Close menu when a link is clicked
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            if (mobileMenu.classList.contains('menu-open')) {
                toggleMenu();
            }
        });
    });
    
    function applyScrolled() {
        navbar.style.backgroundColor = '#ffffff';
        navbar.style.backdropFilter = 'blur(12px)';
        navbar.style.boxShadow = '0 4px 6px -1px rgb(0 0 0 / 0.1)';
        navbar.style.paddingTop = '0.5rem';
        navbar.style.paddingBottom = '0.5rem';
        navbar.classList.add('scrolled');
    }

    function removeScrolled() {
        navbar.style.backgroundColor = 'transparent';
        navbar.style.backdropFilter = 'none';
        navbar.style.boxShadow = 'none';
        navbar.style.paddingTop = '0.75rem';
        navbar.style.paddingBottom = '0.75rem';
        navbar.classList.remove('scrolled');
    }

    // Check initial scroll position on load
    if (window.scrollY > 50) {
        applyScrolled();
    }

    // Add scroll event listener
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            applyScrolled();
        } else {
            removeScrolled();
        }
    });
</script>
