---
import { urlFor } from '../lib/sanity';
import { getHomePage, getSiteSettings } from '../lib/queries';

const homePage = await getHomePage();
const settings = await getSiteSettings();

const slides = homePage?.heroSlides?.length ? homePage.heroSlides.map((s: any) => ({
    image: s?.asset ? urlFor(s).width(1920).format('webp').url() : '',
    alt: s?.alt ?? 'Cabinet Dentaire Chorfi'
})) : [
    { image: "/images/Diaporama hero image/1ere photo.webp", alt: "Cabinet Dentaire Chorfi 1" },
    { image: "/images/Diaporama hero image/2eme photo.webp", alt: "Cabinet Dentaire Chorfi 2" },
    { image: "/images/Diaporama hero image/3eme photo.webp", alt: "Cabinet Dentaire Chorfi 3" },
    { image: "/images/Diaporama hero image/4eme photo.webp", alt: "Cabinet Dentaire Chorfi 4" },
    { image: "/images/Diaporama hero image/5eme photo.webp", alt: "Cabinet Dentaire Chorfi 5" }
];

const socialLinks = settings?.socialLinks ?? [];
const whatsappNumber = settings?.whatsappNumber ?? '212644801152';
const appointmentUrl = settings?.appointmentUrl ?? 'https://dentisto.ma/rendez-vous/docteurs/chorfi-zainab-2520';
const googleRating = settings?.googleRating ?? 5.0;
const googleReviewsUrl = settings?.googleMapsUrl ?? 'https://www.google.com/maps/place/CABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab/@34.0377681,-6.8033237,17z/data=!4m16!1m9!3m8!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!2sCABINET+DENTAIRE+CHORFI+Dr+CHORFI+Zainab!8m2!3d34.0378219!4d-6.803389!9m1!1b1!16s%2Fg%2F11x8_5f85j!3m5!1s0xda741f8f835d4d3:0x52d01fb697aaeaf4!8m2!3d34.0378219!4d-6.803389!16s%2Fg%2F11x8_5f85j?entry=ttu&g_ep=EgoyMDI2MDIyNS4wIKXMDSoASAFQAw%3D%3D';
