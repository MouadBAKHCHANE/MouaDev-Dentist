<style>
    /* Start hidden so content never flashes before the slide-in animation runs */
    .hero-fade-up,
    .hero-social-link {
        opacity: 0;
        visibility: hidden;
    }
</style>

<script>
    import { gsap } from 'gsap';

    // Slide transition logic
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    let currentSlide = 0;

    function updateDots(index) {
        dots.forEach((dot, i) => {
            if (i === index) {
                dot.classList.add('bg-oralix-brand', 'w-8');
                dot.classList.remove('bg-white/20', 'w-4');
            } else {
                dot.classList.remove('bg-oralix-brand', 'w-8');
                dot.classList.add('bg-white/20', 'w-4');
            }
        });
    }

    function nextSlide() {
        const next = (currentSlide + 1) % slides.length;
        
        // Fade out current
        gsap.to(slides[currentSlide], {
            opacity: 0,
            duration: 1.0,
            ease: "power2.inOut"
        });
        
        // Fade in next
        gsap.to(slides[next], {
            opacity: 1,
            duration: 1.0,
            ease: "power2.inOut"
        });
        
        updateDots(next);
        currentSlide = next;
    }

    // Change slide every 4 seconds
    setInterval(nextSlide, 4000);

    // Initial animations
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.fromTo('.hero-fade-up',
        { y: 60, opacity: 0, visibility: 'hidden' },
        { y: 0, opacity: 1, visibility: 'visible', duration: 1.2, stagger: 0.2 },
        0.3
    );
    tl.fromTo('.hero-social-link',
        { y: 60, opacity: 0, visibility: 'hidden' },
        { y: 0, opacity: 1, visibility: 'visible', duration: 1.2, stagger: 0.15 },
        0.3
    );
</script>
