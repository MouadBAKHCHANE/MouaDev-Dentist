---
// src/components/PageHeader.astro
interface Props {
    title: string;
    subtitle: string;
    image?: string;
}

const { title, subtitle, image } = Astro.props;
---

<section class="relative pt-48 pb-24 bg-[#141C18] overflow-hidden rounded-b-[4rem]">
    {image && (
        <div class="absolute inset-0 z-0">
            <img src={image} alt={title} class="w-full h-full object-cover object-center" />
            <div class="absolute inset-0 bg-black/60 lg:bg-black/50"></div>
        </div>
    )}

    {/* Abstract Background Shapes */}
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-[#D1F26E]/5 to-transparent pointer-events-none z-0"></div>
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#D1F26E]/10 rounded-full blur-[100px] pointer-events-none z-0"></div>
    
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="flex flex-col items-center text-center">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/10 mb-8 bg-white/5 backdrop-blur-md page-header-fade" style="opacity: 0; visibility: hidden;">
                <span class="w-1.5 h-1.5 rounded-full bg-[#D1F26E] animate-pulse"></span>
                <span class="text-xs font-bold text-[#D1F26E] uppercase tracking-[0.2em]">{subtitle}</span>
            </div>
            <h1 class="text-5xl md:text-7xl lg:text-[5rem] font-bold text-white font-bricolage tracking-tight leading-[1.1] page-header-fade" style="opacity: 0; visibility: hidden;">
                {title}
            </h1>
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    
    gsap.fromTo('.page-header-fade', 
        { y: 30, opacity: 0, visibility: 'hidden' },
        {
            y: 0,
            opacity: 1,
            visibility: 'visible',
            duration: 1.2,
            stagger: 0.2,
            ease: 'power4.out',
            delay: 0.1
        }
    );
</script>
