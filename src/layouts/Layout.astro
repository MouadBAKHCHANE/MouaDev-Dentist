---
interface BreadcrumbItem {
	name: string;
	href: string;
}

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	noIndex?: boolean;
	canonical?: string;
	jsonLd?: Record<string, any> | Record<string, any>[];
	breadcrumbs?: BreadcrumbItem[];
}

const { title, description, ogImage, noIndex, canonical, jsonLd, breadcrumbs } = Astro.props;

const siteUrl = 'https://www.cabinetdentairechorfi.com';
const defaultDescription = 'Cabinet Dentaire Chorfi à Salé - Implants dentaires, blanchiment, orthodontie, soins esthétiques. Dr Zainab Chorfi, votre dentiste de confiance.';
const defaultOgImage = `${siteUrl}/logo.webp`;

const metaDescription = description || defaultDescription;
const metaOgImage = ogImage || defaultOgImage;
const cleanPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = canonical || new URL(cleanPath, siteUrl).href;

// Site-wide graph (WebSite + Dentist + Dr Chorfi), built from Sanity so the
// markup can't drift from the content shown on the page.
const siteJsonLd = await buildSiteSchema();

const breadcrumbJsonLd = breadcrumbs?.length ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteUrl },
		...breadcrumbs.map((b, i) => ({
			"@type": "ListItem",
			"position": i + 2,
			"name": b.name,
			"item": `${siteUrl}${b.href}`
		}))
	]
} : null;

const extraJsonLd = [
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
	...(breadcrumbJsonLd ? [breadcrumbJsonLd] : [])
];

const allJsonLd = [...siteJsonLd, ...extraJsonLd];

import '../styles/global.css';
import FloatingContact from '../components/FloatingContact.astro';
import { buildSiteSchema } from '../lib/schema';
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="google-site-verification" content="VW5tGvfrNRDS3vcsip9aPcjRF-XyJm6GO8NJlDZ1NKE" />
		<meta name="description" content={metaDescription} />
		<meta name="viewport" content="width=device-width" />
		<!-- Favicons -->
		<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=2" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#141C18" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="fr-MA" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

		{noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={metaOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="fr_MA" />
		<meta property="og:site_name" content="Cabinet Dentaire Chorfi" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={metaOgImage} />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600&display=swap">
        <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'"  />
        <noscript><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"></noscript>
		<title>{title}</title>

		{allJsonLd.map((ld) => (
			<script type="application/ld+json" set:html={JSON.stringify(ld)} />
		))}
		<slot name="head" />
	</head>
	<body class="font-inter text-oralix-text-main antialiased bg-oralix-gray overflow-x-hidden selection:bg-oralix-brand selection:text-oralix-dark">
		<slot />
        <FloatingContact />

        <script>
            // Smooth scrolling setup using Lenis (Standard modern stack practice replacing old locomotive scroll)
            import Lenis from 'lenis';
            import gsap from 'gsap';
            import { ScrollTrigger } from 'gsap/ScrollTrigger';

            gsap.registerPlugin(ScrollTrigger);

            const lenis = new Lenis({
                autoRaf: true,
                smoothTouch: false,
            });

            // Keep GSAP ScrollTrigger strictly in sync with Lenis
            lenis.on('scroll', ScrollTrigger.update);

            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);
        </script>
	</body>
</html>
